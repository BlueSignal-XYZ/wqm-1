[Unit]
Description=WQM-1 radio (rfkill/regdom US) and per-card hostname from serial
After=local-fs.target NetworkManager.service cloud-config.service
Wants=NetworkManager.service
Before=bluesignal-ap-fallback.service bluesignal-service-window.service bluesignal-wqm.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wqm1-firstboot
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
