[Unit]
Description=WQM-1 radio (rfkill/regdom US), hostname, and card/Pi binding
After=local-fs.target NetworkManager.service cloud-config.service wqm1-boot-stage.service
Wants=NetworkManager.service wqm1-boot-stage.service
Before=bluesignal-ap-fallback.service bluesignal-service-window.service bluesignal-wqm.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wqm1-firstboot
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
