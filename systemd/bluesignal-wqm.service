[Unit]
Description=BlueSignal WQM-1 Water Quality Monitor
After=network.target

[Service]
# Type=notify + WatchdogSec: the supervisor sends READY=1 once workers are up
# and WATCHDOG=1 every tick ONLY while every worker thread is provably alive.
# A hung worker (blocking call that never returns) starves the pet and systemd
# restarts the service — Restart=on-failure alone could never catch a hang.
Type=notify
# Yield the one core on a Pi Zero W while this process imports hardware
# and starts workers. The Service Window no longer waits for READY=1, but
# both still share the CPU. StartupCPUWeight applies until we go active;
# CPUWeight is the steady share after that. Nice= is the portable fallback
# when the cpu controller is missing.
Nice=10
StartupCPUWeight=20
CPUWeight=50
NotifyAccess=main
WatchdogSec=180
User=pi
SupplementaryGroups=dialout gpio i2c spi
RuntimeDirectory=bluesignal
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/bluesignal/current/src
ExecStart=/usr/bin/python3 -m main
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/bluesignal/current/src

[Install]
WantedBy=multi-user.target
