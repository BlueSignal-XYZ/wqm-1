[Unit]
Description=BlueSignal WQM-1 First-Boot Provisioning Check
After=network-online.target bluesignal-card.service
Wants=network-online.target
ConditionPathExists=!/etc/bluesignal/.provisioned

[Service]
Type=oneshot
# Journal hint only. Must not steal the core from the setup page.
Nice=10
CPUWeight=20
ExecStart=/opt/bluesignal/current/scripts/first-boot-check.sh
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
