# ---------------------------------------------------------------
# WQM-1 Configuration — /etc/bluesignal/config.yaml
# ---------------------------------------------------------------
# This file is loaded at startup by the WQM-1 firmware.
# Any field omitted here falls back to its built-in default.
# See src/utils/config.py for the full list of fields.
# ---------------------------------------------------------------

# --- Timing (seconds) ---
sensor_read_s: 60            # How often to read all sensors
lora_tx_s: 300               # How often to transmit via LoRaWAN
gps_fix_s: 600               # How often to attempt a GPS fix
gps_fix_timeout_s: 60        # Max seconds to wait for GPS lock

# --- GPS ---
# u-blox UART baud rate. 38400 is what the module fitted on the WQM-1 uses,
# so this should not need changing on our hardware. Other u-blox parts vary
# (NEO-6/7/8 default to 9600, some custom modules ship at 115200). If GPS
# init succeeds but no fix is ever logged, run diagnostics.sh — it reads at
# the configured rate and, failing that, sweeps and names the one that works.
gps_baud: 38400

# --- LoRaWAN ---
# 32-character hex string — your AppKey from TTN or ChirpStack.
# Replace the placeholder below with your actual key.
app_key: "00000000000000000000000000000000"

# --- Cloud over WiFi (optional; coexists with LoRaWAN) ---
# Set cloud_enabled: true and paste the device API key to report readings and
# accept relay commands over HTTP. Easiest via the service window /provision page.
cloud_enabled: false
api_key: ""          # device API key (X-API-Key), bound to this device id
cloud_ingest_url: "https://us-central1-waterquality-trading.cloudfunctions.net/ingestReading"
cloud_command_url: "https://us-central1-waterquality-trading.cloudfunctions.net/deviceCommands"
sync_interval_s: 300     # how often to upload buffered readings
command_poll_s: 5        # how often to poll for relay commands
batch_size: 50
max_retries: 3
retry_delays: [5, 15, 30]
api_endpoint: "https://your-cloud-endpoint.example.com/api/v1/readings"   # legacy/unused

# --- Storage ---
db_path: "/var/lib/bluesignal/wqm1.db"
log_path: "/var/log/bluesignal/wqm1.log"
log_max_bytes: 10485760      # 10 MB
log_backup_count: 5
db_max_rows: 100000

# --- Thermal management ---
fan_on_temp_c: 60.0          # Turn fan on above this CPU temp
fan_off_temp_c: 55.0         # Turn fan off below this CPU temp

# --- Smart breaker / AWG load control (optional) ---
# WQM-1 can ask an EXISTING residential smart breaker to energise or
# de-energise the customer's AWG (atmospheric water generator) circuit. It is
# not a breaker itself and does no panel work. The G5Q-14 relays stay as the
# local interlock / fallback path. See docs/smart-breaker-integration.md and
# docs/smart-breaker-installer-guide.md.
#
#   smart_breaker_vendor:  none        - feature off (default)
#                          relay_only  - AWG enable on a G5Q channel; no cloud API
#                          ableedge    - Eaton AbleEdge / Smart Breaker API
#   smart_breaker_fail_safe: off | last | on   - load state when the breaker API
#                          has been unreachable for smart_breaker_unreachable_grace_s.
#                          `off` is the shipped default for compressor loads.
#   smart_breaker_circuit_amps: entered by the INSTALLER from the panel label.
#                          0 = not entered. The firmware never guesses this.
smart_breaker_vendor: "none"
smart_breaker_device_id: ""           # Eaton device UUID bound to the AWG circuit
smart_breaker_site_id: ""             # Eaton locationId (site) the device belongs to
smart_breaker_circuit_label: ""       # e.g. "Panel A / 14 — AWG-1"
smart_breaker_circuit_amps: 0
smart_breaker_interlock_relay: 0      # 0 = none, 1-4 = G5Q channel in series with AWG enable
smart_breaker_poll_s: 60
smart_breaker_fail_safe: "off"          # quote it: bare off/on are YAML booleans
smart_breaker_unreachable_grace_s: 300
# Auth. `direct` = this unit holds Eaton ORGANISATION service-account credentials.
# `cloud_proxy` = the BlueSignal Cloud Functions hold them (preferred; pending).
# Credentials are provisioning-time only, never pushed remotely, never committed.
smart_breaker_auth_mode: "direct"
smart_breaker_api_base: "https://api.em.eaton.com/api/v1"
smart_breaker_token_url: "https://api.em.eaton.com/oauth2/token"
smart_breaker_client_id: ""
smart_breaker_client_secret: ""
smart_breaker_subscription_key: ""

# --- Service window (local web UI) ---
service_window:
  enabled: true
  port: 8080
  pin: "1234"               # Change on first use

# --- Automation rules (optional) ---
# Threshold-based relay automation. Each rule evaluates a sensor value
# against a threshold and triggers a relay action.
#
# Fields:
#   sensor:      ph | tds_ppm | turbidity_ntu | orp_mv | temp_c
#   operator:    > | < | >= | <= | ==
#   threshold:   numeric trigger value
#   relay:       1-4
#   action:      on | off
#   duration_s:  auto-shutoff seconds (0 = stay until another rule clears)
#
# Safety policies (schedule, cooldown, max on-time) are configured
# separately in config/policies.yaml. NOTE: relay automation is gated OFF by
# default via `manual.override: true` in policies.yaml — these rules stay inert
# until you set it to false. Enable only after wiring/assigning relays and
# confirming the sensors that drive them are seated and reading in range.
#
# Default relay assignments:
#   Relay 1 — Acid dosing pump
#   Relay 2 — Base dosing pump
#   Relay 3 — Aerator / air pump
#   Relay 4 — Circulation pump / flush valve
rules:
  # Relay 1 — Acid dosing (high pH correction)
  - sensor: ph
    operator: ">"
    threshold: 8.5
    relay: 1
    action: "on"
    duration_s: 30
  - sensor: ph
    operator: "<="
    threshold: 7.5
    relay: 1
    action: "off"
    duration_s: 0

  # Relay 2 — Base dosing (low pH correction)
  - sensor: ph
    operator: "<"
    threshold: 6.0
    relay: 2
    action: "on"
    duration_s: 30
  - sensor: ph
    operator: ">="
    threshold: 6.8
    relay: 2
    action: "off"
    duration_s: 0

  # Relay 3 — Aerator (low ORP / high turbidity)
  - sensor: orp_mv
    operator: "<"
    threshold: 200.0
    relay: 3
    action: "on"
    duration_s: 0
  - sensor: orp_mv
    operator: ">="
    threshold: 300.0
    relay: 3
    action: "off"
    duration_s: 0
  - sensor: turbidity_ntu
    operator: ">"
    threshold: 500.0
    relay: 3
    action: "on"
    duration_s: 300
  - sensor: tds_ppm
    operator: "<"
    threshold: 50.0
    relay: 3
    action: "on"
    duration_s: 180

  # Relay 4 — Circulation / flush (high TDS, high temp, extreme turbidity)
  - sensor: tds_ppm
    operator: ">"
    threshold: 2000.0
    relay: 4
    action: "on"
    duration_s: 120
  - sensor: tds_ppm
    operator: "<="
    threshold: 1500.0
    relay: 4
    action: "off"
    duration_s: 0
  - sensor: temp_c
    operator: ">"
    threshold: 35.0
    relay: 4
    action: "on"
    duration_s: 0
  - sensor: temp_c
    operator: "<="
    threshold: 30.0
    relay: 4
    action: "off"
    duration_s: 0
  - sensor: turbidity_ntu
    operator: ">"
    threshold: 1000.0
    relay: 4
    action: "on"
    duration_s: 60

  # Safety — emergency shutoffs at extreme temperature
  - sensor: temp_c
    operator: ">"
    threshold: 45.0
    relay: 1
    action: "off"
    duration_s: 0
  - sensor: temp_c
    operator: ">"
    threshold: 45.0
    relay: 2
    action: "off"
    duration_s: 0
